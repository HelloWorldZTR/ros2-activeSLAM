        <collision name="collision"><geometry><box><size>2.8 0.08 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.8 0.08 0.75</size></box></geometry><material><ambient>0.56 0.67 0.78 1</ambient><diffuse>0.56 0.67 0.78 1</diffuse></material></visual>
      </link>
      <link name="center_island_west">
