<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <gui>
      <camera name="user_camera">
        <pose>0 -12 14 0 0.95 1.5708</pose>
      </camera>
    </gui>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.55 0.58 0.62 1</background>
      <shadows>1</shadows>
      <grid>0</grid>
      <origin_visual>0</origin_visual>
    </scene>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Open arena with asymmetric 2D lidar landmarks. Gaps are kept wide for small TurtleBots. -->
    <model name="slam_landmark_walls">
      <static>true</static>

      <link name="north_wall_left">
        <pose>-3.2 5 0.35 0 0 0</pose>
