<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <gui>
      <camera name="user_camera">
        <pose>0 -10 12 0 0.95 1.5708</pose>
      </camera>
    </gui>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.55 0.58 0.62 1</background>
      <shadows>1</shadows>
      <grid>0</grid>
      <origin_visual>0</origin_visual>
    </scene>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Scaled for TurtleBot-class robots: 0.08 m wall thickness, 0.75 m height, >= 1.1 m lanes. -->
    <model name="slam_loop_walls">
      <static>true</static>

      <link name="north_wall">
        <pose>0 4 0.375 0 0 0</pose>
        <collision name="collision"><geometry><box><size>11 0.08 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>11 0.08 0.75</size></box></geometry><material><ambient>0.74 0.74 0.70 1</ambient><diffuse>0.74 0.74 0.70 1</diffuse></material></visual>
      </link>
      <link name="south_wall">
        <pose>0 -4 0.375 0 0 0</pose>
