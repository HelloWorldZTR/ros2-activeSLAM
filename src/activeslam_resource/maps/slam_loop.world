        <visual name="visual"><geometry><box><size>8 0.08 0.75</size></box></geometry><material><ambient>0.74 0.74 0.70 1</ambient><diffuse>0.74 0.74 0.70 1</diffuse></material></visual>
      </link>

      <link name="center_island_north">
        <pose>2.5 1.4 0.375 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.0 0.08 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.0 0.08 0.75</size></box></geometry><material><ambient>0.56 0.67 0.78 1</ambient><diffuse>0.56 0.67 0.78 1</diffuse></material></visual>
      </link>
      <link name="center_island_south">
